# ------------------------------------------------------------------------------
# MySQL DATABASE CONFIGURATION (For Hostinger / Cloud MySQL)
# ------------------------------------------------------------------------------
# When deployed to Hostinger (cPanel / VPS / Cloud), set your MySQL database details here.
# If these are left blank or offline, the app seamlessly uses local JSON persistence
# so the app never crashes and you can preview everything instantly!
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=husnain_portfolio

# App Base URL (For SEO Canonical URLs and XML Sitemap)
APP_URL=http://localhost:3000

# Gemini API Key (Optional AI assistant / post enhancement)
GEMINI_API_KEY=
