# Server Port (Default: 3000)
PORT=3000
NODE_ENV=development

# JWT Authentication Secret (Set a long random string for production)
JWT_SECRET=husnain_nawaz_secure_jwt_token_key_change_in_production_894103829

# Admin Authentication Credentials
# Initial admin login: admin / husnain@admin2026!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=husnain@admin2026!
